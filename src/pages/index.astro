---
/**
 * Homepage = the full "sequence" (lead-owned integration).
 * Section order mirrors src/lib/chapters.ts; markers are numbered from it.
 */
import { getEntry } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import PersonJsonLd from "../components/seo/PersonJsonLd.astro";
import Hero from "../components/sections/Hero/Hero.astro";
import TrustBar from "../components/sections/TrustBar/TrustBar.astro";
import Services from "../components/sections/Services/Services.astro";
import Work from "../components/sections/Work/Work.astro";
import BeforeAfterSection from "../components/sections/BeforeAfter/BeforeAfterSection.astro";
import Reviews from "../components/sections/Reviews/Reviews.astro";
import Process from "../components/sections/Process/Process.astro";
import Tools from "../components/sections/Tools/Tools.astro";
import About from "../components/sections/About/About.astro";
import Contact from "../components/sections/Contact/Contact.astro";
import { markerFor } from "../lib/chapters";

const site = await getEntry("site", "main");
const positioning = await getEntry("positioning", "main");
if (!site || !positioning) throw new Error("site/positioning entries missing");

const title = `${site.data.name.full} · ${site.data.jobTitle} for Podcasts, Interviews & Courses`;
const description = positioning.data.fiveSecond.line;
---

<PageLayout title={title} description={description}>
  <PersonJsonLd slot="head" />
  <Hero />
  <TrustBar />
  <Services marker={markerFor("services")} />
  <Work marker={markerFor("work")} />
  <BeforeAfterSection marker={markerFor("before-after")} />
  <Reviews marker={markerFor("reviews")} />
  <Process marker={markerFor("process")} />
  <Tools marker={markerFor("tools")} />
  <About marker={markerFor("about")} />
  <Contact marker={markerFor("contact")} />
</PageLayout>
