---
/**
 * "Media offline", on brand: a quiet program-monitor frame with crop marks,
 * a mini ruler + waveform strip and a parked playhead. Same footprint as the
 * real media (aspect-ratio box), so swapping in footage causes zero CLS.
 */
import clsx from "clsx";
import Timecode from "./Timecode.astro";
import { ratioVariants, type MediaRatio } from "./media";
import { placeholderWaveform } from "./waveform";

const trackVariants = {
  video: { label: "V1", text: "text-clip-v" },
  audio: { label: "A1", text: "text-clip-a" },
} as const;

interface Props {
  ratio?: MediaRatio;
  /** Visible mono label. */
  label?: string;
  /** Accessible description of the missing media. */
  description?: string;
  /** Optional decorative timecode (seconds) in the top-left corner. */
  timecode?: number;
  track?: keyof typeof trackVariants;
  class?: string;
}

const {
  ratio = "16/9",
  label = "Sample coming soon",
  description = "Video sample coming soon",
  timecode,
  track = "video",
  class: className,
} = Astro.props;

const bars = placeholderWaveform("clean");
const ticks = Array.from({ length: 41 }, (_, i) => i);
const t = trackVariants[track];
---

<div
  role="img"
  aria-label={description}
  class={clsx(
    "relative isolate overflow-hidden rounded-sm border border-line bg-panel",
    ratioVariants[ratio],
    className,
  )}
>
  <div aria-hidden="true" class="absolute inset-0">
    {/* Soft vignette so the frame reads as a monitor, not an empty box */}
    <div class="absolute inset-0 bg-radial from-panel-raised to-ink"></div>

    {/* Title-safe area + crop marks */}
    <div class="absolute inset-1/10 rounded-xs border border-dashed border-line/70"></div>
    <span class="absolute top-3 left-3 size-3 border-t border-l border-muted/60"></span>
    <span class="absolute top-3 right-3 size-3 border-t border-r border-muted/60"></span>
    <span class="absolute bottom-3 left-3 size-3 border-b border-l border-muted/60"></span>
    <span class="absolute right-3 bottom-3 size-3 border-r border-b border-muted/60"></span>

    {/* Corner metadata */}
    <div class="absolute inset-x-6 top-5 flex items-center justify-between gap-2">
      {timecode !== undefined ? <Timecode seconds={timecode} /> : <span />}
      <span class={clsx("font-mono text-label", t.text)}>{t.label}</span>
    </div>

    {/* Centre label */}
    <div class="absolute inset-0 grid place-items-center p-6">
      <div class="flex flex-col items-center gap-3 text-center">
        <span class="flex items-center gap-2 font-mono text-label text-paper uppercase">
          <span class="size-1.5 rounded-pill bg-playhead"></span>
          Media offline
        </span>
        <span class="font-mono text-label text-muted uppercase">{label}</span>
      </div>
    </div>

    {/* Mini timeline: ruler + waveform + parked playhead */}
    <div class="absolute inset-x-6 bottom-5 flex h-1/6 max-h-16 min-h-8 flex-col gap-1">
      <svg
        viewBox="0 0 400 6"
        preserveAspectRatio="none"
        class="h-1.5 w-full shrink-0 text-line"
        fill="currentColor"
      >
        {ticks.map((i) => (
          <rect x={i * 10 - 0.5} y={i % 5 === 0 ? 0 : 3} width="1" height={i % 5 === 0 ? 6 : 3} />
        ))}
      </svg>
      <svg
        viewBox={`0 0 ${bars.length * 4} 40`}
        preserveAspectRatio="none"
        class={clsx("w-full grow opacity-50", t.text)}
        fill="currentColor"
      >
        {bars.map((v, i) => (
          <rect x={i * 4 + 0.75} y={20 - v * 19} width="2.5" height={v * 38} rx="1" />
        ))}
      </svg>
      {/* Playhead parked at 40% — static, purely decorative */}
      <span class="absolute inset-y-0 left-2/5 w-px bg-playhead"></span>
    </div>
  </div>
</div>
