---
/**
 * Global sticky "timeline ruler" (lead-owned chrome) — the signature of concept A.
 * - Chapter markers = primary navigation (real links, keyboard accessible).
 * - Playhead + timecode follow page scroll progress (decorative, aria-hidden).
 * Vanilla TS + GSAP (no React) so the chrome costs no hydration on first load.
 */
import { getEntry } from "astro:content";
import Icon from "../ui/Icon.astro";
import { chapterNumber, type ChapterId } from "../../lib/chapters";

export interface Chapter {
  id: ChapterId;
  label: string;
}

interface Props {
  chapters: readonly Chapter[];
}

const { chapters } = Astro.props;
const site = await getEntry("site", "main");
const upwork = await getEntry("links", "upwork");
if (!site || !upwork) throw new Error("site/links entries missing");

const TICKS = 48; // ruler tick count — purely decorative density
const isHome = Astro.url.pathname === "/";
const chapterHref = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<header
  class="sticky top-0 z-(--z-ruler) h-ruler border-b border-line bg-ink/90 backdrop-blur-md"
  style="--progress: 0"
  data-ruler
>
  <div class="mx-auto flex h-full max-w-content items-center gap-4 px-gutter">
    <a
      href="/"
      class="flex min-w-0 items-center gap-2 font-display text-body-sm font-semibold tracking-tight"
    >
      <span class="inline-block size-2 rounded-pill bg-playhead" aria-hidden="true"></span>
      <span class="truncate">{site.data.name.full}</span>
    </a>

    <nav aria-label="Sections" class="@container relative hidden h-full flex-1 lg:block">
      <!-- tick marks (decorative) -->
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 flex h-2 justify-between"
        aria-hidden="true"
      >
        {Array.from({ length: TICKS }, (_, i) => (
          <span class:list={["w-px bg-line", i % 4 === 0 ? "h-2" : "h-1 self-end"]} />
        ))}
      </div>
      <ol class="relative flex h-full items-center justify-between">
        {chapters.map((c) => (
          <li>
            <a
              href={chapterHref(c.id)}
              class="group flex items-center gap-1.5 rounded-xs px-1 font-mono text-label text-muted uppercase hover:text-paper motion-safe:transition-colors motion-safe:duration-(--duration-fast) motion-safe:ease-trim aria-[current=location]:text-paper"
              data-chapter={c.id}
            >
              <span class="tabular-nums" aria-hidden="true">
                {chapterNumber(c.id)}
              </span>
              {c.label}
            </a>
          </li>
        ))}
      </ol>
      <!-- playhead (decorative): position via --progress (0–1) -->
      <!-- arbitrary value: playhead offset = scroll progress × nav width (container query units) -->
      <div
        class="pointer-events-none absolute inset-y-0 left-0 w-px translate-x-[calc(var(--progress)*100cqw)] bg-playhead shadow-playhead"
        aria-hidden="true"
      ></div>
    </nav>

    <!-- below lg: compact chapter menu (the ruler nav needs the width) -->
    <details class="group/menu relative ml-auto lg:hidden" data-chapter-menu>
      <summary class="flex min-h-6 cursor-pointer list-none items-center gap-1.5 rounded-xs px-1 font-mono text-label text-muted uppercase hover:text-paper [&::-webkit-details-marker]:hidden">
        Sections
        <Icon name="arrow-right" size="sm" class="rotate-90 group-open/menu:-rotate-90" />
      </summary>
      <!-- arbitrary value: keep the panel inside the viewport at 320px (minus both gutters) -->
      <nav
        aria-label="Sections"
        class="absolute top-full right-0 mt-3 w-56 max-w-[calc(100vw-2*var(--spacing-gutter))] rounded-sm border border-line bg-panel p-2 shadow-panel"
      >
        <ol class="flex flex-col">
          {chapters.map((c) => (
            <li>
              <a
                href={chapterHref(c.id)}
                class="flex items-center gap-2 rounded-xs px-2 py-2 font-mono text-label text-paper uppercase hover:bg-panel-raised"
              >
                <span class="text-muted tabular-nums" aria-hidden="true">
                  {chapterNumber(c.id)}
                </span>
                {c.label}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>

    <div class="flex shrink-0 items-center gap-3 lg:ml-auto">
      <span
        class="hidden font-mono text-label text-muted tabular-nums sm:inline"
        aria-hidden="true"
        data-timecode
      >
        00:00:00:00
      </span>
      <a
        href={upwork.data.url}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 rounded-sm bg-playhead px-3 py-1.5 text-body-sm font-semibold text-ink hover:bg-playhead-hover motion-safe:transition-colors motion-safe:duration-(--duration-fast) motion-safe:ease-trim"
      >
        Hire<span class="sr-only sm:not-sr-only">&nbsp;on Upwork</span>
        <Icon name="arrow-up-right" class="size-3.5" />
        <span class="sr-only">(opens in new tab)</span>
      </a>
    </div>
  </div>
  <!-- mobile progress bar (decorative) -->
  <div
    class="absolute inset-x-0 bottom-0 h-px origin-left scale-x-(--progress) bg-playhead lg:hidden"
    aria-hidden="true"
    data-progress-bar
  ></div>
</header>

<script>
  import { ScrollTrigger } from "../../lib/gsap";
  import { SEQUENCE_RUNTIME_S } from "../../lib/motion";
  import { formatTimecode } from "../ui/timecode";

  let triggers: ScrollTrigger[] = [];
  let menuAbort: AbortController | null = null;

  function setup(): void {
    const ruler = document.querySelector<HTMLElement>("[data-ruler]");
    if (!ruler) return;
    const timecode = ruler.querySelector<HTMLElement>("[data-timecode]");

    // Mobile chapter menu: closes on Escape and outside click (link clicks: lib/smooth-scroll.ts).
    // All listeners share one AbortController, aborted on the next page swap.
    const menu = ruler.querySelector<HTMLDetailsElement>("[data-chapter-menu]");
    if (menu) {
      menuAbort = new AbortController();
      const { signal } = menuAbort;
      document.addEventListener(
        "keydown",
        (e) => {
          if (e.key !== "Escape" || !menu.open) return;
          menu.open = false;
          menu.querySelector("summary")?.focus();
        },
        { signal },
      );
      // Close when keyboard focus leaves the menu.
      menu.addEventListener(
        "focusout",
        (e) => {
          if (!(e.relatedTarget instanceof Node && menu.contains(e.relatedTarget)))
            menu.open = false;
        },
        { signal },
      );
      document.addEventListener(
        "pointerdown",
        (e) => {
          if (menu.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
        },
        { signal },
      );
    }

    triggers.push(
      ScrollTrigger.create({
        start: 0,
        end: "max",
        onUpdate: (self) => {
          ruler.style.setProperty("--progress", self.progress.toFixed(4));
          if (timecode) timecode.textContent = formatTimecode(self.progress * SEQUENCE_RUNTIME_S);
        },
      }),
    );

    // Active chapter → aria-current on its marker.
    ruler.querySelectorAll<HTMLAnchorElement>("[data-chapter]").forEach((link) => {
      const section = document.getElementById(link.dataset.chapter ?? "");
      if (!section) return;
      triggers.push(
        ScrollTrigger.create({
          trigger: section,
          start: "top center",
          end: "bottom center",
          onToggle: (self) =>
            self.isActive
              ? link.setAttribute("aria-current", "location")
              : link.removeAttribute("aria-current"),
        }),
      );
    });
  }

  function teardown(): void {
    triggers.forEach((t) => t.kill());
    triggers = [];
    menuAbort?.abort();
    menuAbort = null;
  }

  document.addEventListener("astro:page-load", setup);
  document.addEventListener("astro:before-swap", teardown);
</script>
