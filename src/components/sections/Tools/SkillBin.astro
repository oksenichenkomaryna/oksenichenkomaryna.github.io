---
/**
 * A skills group rendered as an open project-panel folder ("bin"):
 * folder heading + item count, then the tags as a list.
 * Video / Audio groups get their track colour; the rest stay neutral.
 */
import Tag from "../../ui/Tag.astro";

const tagVariantFor = {
  video: "video",
  audio: "audio",
} as const satisfies Record<string, "video" | "audio">;

interface Props {
  id: string;
  group: string;
  items: string[];
}

const { id, group, items } = Astro.props;
const variant = id in tagVariantFor ? tagVariantFor[id as keyof typeof tagVariantFor] : "default";
const headingId = `skills-${id}`;
---

<li data-reveal="cut">
  <h3 id={headingId} class="flex items-center gap-2 font-mono text-label text-paper uppercase">
    <!-- open-folder glyph (decorative) -->
    <span aria-hidden="true" class="text-muted">
      ▾
    </span>
    <svg
      aria-hidden="true"
      viewBox="0 0 16 12"
      class="h-3 w-4 shrink-0 text-muted"
      fill="none"
      stroke="currentColor"
    >
      <path d="M.5 1.5a1 1 0 0 1 1-1h4l1.5 1.5h7.5a1 1 0 0 1 1 1v7.5a1 1 0 0 1-1 1h-13a1 1 0 0 1-1-1z"></path>
    </svg>
    {group}
    <span class="ml-auto text-muted tabular-nums" aria-hidden="true">
      {items.length}
    </span>
  </h3>
  <ul
    aria-labelledby={headingId}
    class="mt-3 ml-1.5 flex flex-wrap gap-2 border-l border-line pt-1 pl-5"
  >
    {items.map((label) => (
      <Tag as="li" variant={variant} font="sans">
        {label}
      </Tag>
    ))}
  </ul>
</li>
