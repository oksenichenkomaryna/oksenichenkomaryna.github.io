---
/**
 * Tools & skills — styled as Premiere's "Effects" panel.
 * Top: the Adobe tools as typographic badges (no logos — trademarks).
 * Below: every other skills group as a folder ("bin") with its tags.
 */
import { getCollection, getEntry } from "astro:content";
import Card from "../../ui/Card.astro";
import Heading from "../../ui/Heading.astro";
import Section from "../../ui/Section.astro";
import ToolBadge from "./ToolBadge.astro";
import SkillBin from "./SkillBin.astro";

interface Props {
  marker?: string;
}

const { marker } = Astro.props;
const sectionId = "tools";

const site = await getEntry("site", "main");
if (!site) throw new Error("site collection: entry 'main' missing");

const groups = (await getCollection("skills")).sort((a, b) => a.data.order - b.data.order);
const tools = groups.find((g) => g.data.group === "Tools");
const bins = groups.filter((g) => g.data.group !== "Tools");
const toolsNote = tools?.data.note;
const itemCount = groups.reduce((n, g) => n + g.data.items.length, 0);
---

<Section id={sectionId} marker={marker}>
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-4" data-reveal="cut">
      <Heading level={2} id={`${sectionId}-title`} eyebrow="Effects panel">
        Tools & skills
      </Heading>
      <p class="mt-6 max-w-prose text-body text-muted">
        {toolsNote ? `${toolsNote} · ` : ""}
        {site.data.experienceYears} years of editing.
      </p>
    </div>

    <Card padding="none" class="lg:col-span-8">
      <!-- Panel chrome: tab strip like an editor panel header (decorative) -->
      <div
        aria-hidden="true"
        class="flex items-center justify-between gap-4 border-b border-line bg-ink/40 px-5 py-3 font-mono text-label text-muted uppercase"
      >
        <span class="flex items-center gap-3">
          <span class="border-b border-playhead pb-0.5 text-paper">Effects</span>
          <span>Presets</span>
        </span>
        <span class="tabular-nums">{itemCount} items</span>
      </div>

      <div class="flex flex-col gap-8 p-5 md:p-8" data-reveal-group>
        {tools && (
          <div data-reveal="cut">
            <h3 class="font-mono text-label text-muted uppercase">
              {tools.data.group}
              {toolsNote && <span class="text-muted/70"> · {toolsNote}</span>}
            </h3>
            <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
              {tools.data.items.map((item) => (
                <ToolBadge label={item.label} />
              ))}
            </ul>
          </div>
        )}

        <ul class="grid gap-x-8 gap-y-7 border-t border-line pt-8 md:grid-cols-2">
          {bins.map((bin) => (
            <SkillBin
              id={bin.data.id}
              group={bin.data.group}
              items={bin.data.items.map((i) => i.label)}
            />
          ))}
        </ul>
      </div>
    </Card>
  </div>
</Section>
