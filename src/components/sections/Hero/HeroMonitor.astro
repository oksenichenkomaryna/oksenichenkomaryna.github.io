---
/**
 * Hero "program monitor". With a `reel` it plays the showreel loop (poster = LCP);
 * without one it shows typographic title cards that hero-sequence.ts hard-cuts through
 * once (≈4 s) before resting on the final card. Static rest frame (no JS / reduced
 * motion) = the final card, which lists every service, so nothing is lost.
 * With a reel the frame is never gated: its poster is the LCP and must paint at once.
 */
import clsx from "clsx";
import VideoPlayer from "../../ui/VideoPlayer.astro";
import { formatTimecode } from "../../ui/timecode";
import { CARD_HOLD_S, finalCard, heroGate, titleCards } from "./hero-data";

export interface HeroReel {
  mp4: string;
  webm?: string;
  poster: ImageMetadata;
  /** Describes the loop for screen readers. */
  alt?: string;
}

interface Props {
  reel?: HeroReel;
  class?: string;
}

const { reel, class: className } = Astro.props;
const total = titleCards.length;
const pad = (n: number) => String(n).padStart(2, "0");
const cardClass = "absolute inset-0 grid place-items-center p-6 text-center";
const wordClass = "font-display text-h2 font-extrabold text-paper uppercase";
---

<div
  class={clsx(
    "rounded-md border border-line bg-panel p-1.5 shadow-panel",
    !reel && heroGate,
    className,
  )}
  data-hero-in={reel ? undefined : "cut"}
  data-hero-stage
>
  <div
    class="flex items-center justify-between gap-4 px-1.5 pt-0.5 pb-2 font-mono text-label text-muted uppercase"
    aria-hidden="true"
  >
    <span class="flex items-center gap-2">
      <span class="size-1.5 rounded-pill bg-playhead"></span>
      Program
    </span>
    <span class="text-paper tabular-nums" data-hero-tc>
      {formatTimecode(total * CARD_HOLD_S)}
    </span>
  </div>

  {reel ? (
    <VideoPlayer
      source={{
        kind: "loop",
        mp4: reel.mp4,
        webm: reel.webm,
        poster: reel.poster,
        alt: reel.alt ?? "Showreel: excerpts from recent edits",
      }}
      priority
      sizes="(min-width: 64rem) 40rem, 100vw"
    />
  ) : (
    <div
      class="relative isolate aspect-video overflow-hidden rounded-sm bg-black"
      aria-hidden="true"
    >
      <div class="absolute inset-1/10 rounded-xs border border-dashed border-line/60"></div>

      {titleCards.map((card, i) => (
        <div class={clsx(cardClass, "invisible")} data-hero-card>
          <div class="flex flex-col items-center gap-3">
            <span class={wordClass}>{card.word}</span>
            <span class="font-mono text-label text-muted tabular-nums">
              V1 · {pad(i + 1)}/{pad(total)}
            </span>
          </div>
        </div>
      ))}

      {/* Rest frame: visible by default (no JS / reduced motion), last cut of the pass. */}
      <div class={cardClass} data-hero-card="final">
        <div class="flex flex-col items-center gap-3">
          <span class="max-w-md font-mono text-label text-balance text-muted uppercase">
            {titleCards.map((c) => c.word).join(" · ")}
          </span>
          <span class={clsx(wordClass, "flex flex-col leading-none")}>
            <span>{finalCard.lines[0]}</span>
            <span class="text-playhead">{finalCard.lines[1]}</span>
          </span>
        </div>
      </div>
    </div>
  )}
</div>
