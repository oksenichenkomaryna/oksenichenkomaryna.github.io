---
/**
 * Mini sequence under the hero monitor: ruler + V2/V1/A1/A2 lanes + playhead.
 * Purely decorative (aria-hidden). Static rest frame = playhead parked at the end;
 * hero-sequence.ts rewinds it and plays one pass in sync with the title-card cuts.
 */
import clsx from "clsx";
import TimelineClip from "./TimelineClip.astro";
import { formatTimecode } from "../../ui/timecode";
import { CARD_HOLD_S, heroGate, titleCards, tracks } from "./hero-data";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const segments = titleCards.length;
const TICKS = segments * 10; // minor ticks across the ruler, decorative density
const marks = Array.from({ length: segments }, (_, i) => ({
  at: i / segments,
  label: formatTimecode(i * CARD_HOLD_S),
}));

const headerClass = "flex items-center font-mono text-label text-muted";
const laneVisibility = (secondary: boolean) => (secondary ? "hidden md:flex" : "flex");
---

<div class={clsx("flex gap-2 select-none", className)} aria-hidden="true">
  <!-- Track headers -->
  <div class="flex w-7 shrink-0 flex-col gap-1">
    <span class="h-5"></span>
    {tracks.map((t) => (
      <span class={clsx("h-6", headerClass, laneVisibility(t.secondary))}>{t.id}</span>
    ))}
  </div>

  <!-- Lanes: container-query units let the playhead translate across the full width -->
  <div class="@container relative min-w-0 flex-1" style="--hero-p: 1" data-hero-playhead>
    <div class="flex flex-col gap-1">
      <!-- Ruler -->
      <div class={clsx("relative h-5 border-b border-line", heroGate)} data-hero-in="ruler">
        <svg
          viewBox={`0 0 ${TICKS} 6`}
          preserveAspectRatio="none"
          class="absolute inset-x-0 bottom-0 h-1.5 w-full text-line"
          fill="currentColor"
        >
          {Array.from({ length: TICKS + 1 }, (_, i) => (
            <rect x={i - 0.05} y={i % 10 === 0 ? 0 : 3} width="0.1" height={i % 10 === 0 ? 6 : 3} />
          ))}
        </svg>
        {/* arbitrary value: label position comes from data as a 0–1 CSS var */}
        {marks.map((m, i) => (
          <span
            class={clsx(
              "absolute top-0 left-[calc(var(--at)*100%)] pl-1 font-mono text-label leading-none text-muted tabular-nums",
              i > 0 && "hidden sm:block",
            )}
            style={`--at: ${m.at}`}
          >
            {m.label}
          </span>
        ))}
      </div>

      {tracks.map((t) => (
        <div class={clsx("relative h-6 rounded-xs bg-panel", laneVisibility(t.secondary))}>
          <div class={clsx("absolute inset-0", heroGate)} data-hero-in="track">
            {t.clips.map((c) => (
              <TimelineClip kind={t.kind} {...c} />
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Playhead. arbitrary value: progress (0–1) × lane width in container units, minus its 1px -->
    <div
      class={clsx(
        "pointer-events-none absolute inset-y-0 left-0 w-px translate-x-[calc(var(--hero-p)*(100cqw_-_1px))] bg-playhead shadow-playhead",
        heroGate,
      )}
      data-hero-in="playhead"
    >
      <span class="absolute top-0 left-1/2 h-2 w-2.5 -translate-x-1/2 rounded-b-xs bg-playhead"></span>
    </div>
  </div>
</div>
