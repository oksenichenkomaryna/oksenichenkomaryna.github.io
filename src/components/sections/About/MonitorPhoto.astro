---
/**
 * Portrait in a "program monitor" frame: crop marks, title-safe guide and a mono
 * metadata strip. All chrome is decorative; only the <img> carries meaning (alt).
 * Rendered ≤ 400 CSS px wide — the source is 500×500.
 */
import { Image } from "astro:assets";
import Timecode from "../../ui/Timecode.astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Factual metadata shown in the frame, e.g. "Poznań, Poland". */
  caption: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="mx-auto w-full max-w-100 lg:mx-0">
  <div class="rounded-sm border border-line bg-panel p-2 shadow-panel sm:p-3">
    <div class="relative isolate overflow-hidden rounded-xs bg-ink">
      <Image
        src={src}
        alt={alt}
        widths={[320, 400, 500]}
        sizes="(min-width: 27rem) 400px, calc(100vw - 3rem)"
        loading="lazy"
        decoding="async"
        class="aspect-square w-full object-cover"
      />

      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <!-- title-safe guide + crop marks -->
        <div class="absolute inset-1/10 rounded-xs border border-dashed border-paper/20"></div>
        <span class="absolute top-3 left-3 size-4 border-t-2 border-l-2 border-paper/80"></span>
        <span class="absolute top-3 right-3 size-4 border-t-2 border-r-2 border-paper/80"></span>
        <span class="absolute bottom-3 left-3 size-4 border-b-2 border-l-2 border-paper/80"></span>
        <span class="absolute right-3 bottom-3 size-4 border-r-2 border-b-2 border-paper/80"></span>
      </div>
    </div>

    <!-- monitor status strip (decorative) -->
    <div
      aria-hidden="true"
      class="mt-2 flex items-center justify-between gap-3 px-1 font-mono text-label text-muted uppercase sm:mt-3"
    >
      <span class="flex items-center gap-2">
        <span class="text-clip-v">V1</span>
        <span>{caption}</span>
      </span>
      <Timecode seconds={0} />
    </div>
  </div>
</figure>
