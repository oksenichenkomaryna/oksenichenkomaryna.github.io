---
/**
 * Trust bar under the hero: Upwork track record as clip labels on a track.
 * All numbers come from the stats collection (ordered) and are server-rendered final.
 * Not a chapter (no ruler marker); entrance = data-reveal-group of hard cuts.
 */
import { getCollection, getEntry } from "astro:content";
import Icon from "../../ui/Icon.astro";
import TrustStat from "./TrustStat.astro";

const [site, upwork, stats] = await Promise.all([
  getEntry("site", "main"),
  getEntry("links", "upwork"),
  getCollection("stats"),
]);
if (!site || !upwork) throw new Error("TrustBar: site/links entries missing");

const ordered = [...stats].sort((a, b) => a.data.order - b.data.order);
---

<section aria-labelledby="trust-title" class="border-y border-line bg-panel">
  <div class="mx-auto max-w-content px-gutter py-8 md:py-10">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <h2 id="trust-title" class="font-mono text-label text-muted uppercase">
        Track record
      </h2>
      <p class="flex items-center gap-2 font-mono text-label text-muted uppercase">
        {site.data.verified && (
          <>
            <Icon name="check" size="sm" class="text-clip-a" />
            <span>Upwork · Verified</span>
            <span aria-hidden="true">·</span>
          </>
        )}
        <a
          href={upwork.data.url}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1 rounded-xs text-paper underline decoration-line underline-offset-4 hover:decoration-playhead motion-safe:transition-colors motion-safe:duration-(--duration-fast)"
        >
          Source: Upwork profile
          <Icon name="arrow-up-right" size="sm" />
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </p>
    </div>

    <dl
      class="grid grid-cols-2 gap-px overflow-hidden rounded-sm border border-line bg-line lg:grid-cols-4"
      data-reveal-group
    >
      {ordered.map((s) => (
        <TrustStat {...s.data} stars={s.id === "rating"} />
      ))}
    </dl>
  </div>
</section>
