---
/**
 * Base document (lead-owned). SEO head, fonts, View Transitions, pre-paint motion flags,
 * Lenis smooth scroll. Pages pass title/description; JSON-LD is passed via the `head` slot.
 */
import "@fontsource-variable/inter";
import "@fontsource-variable/inter-tight";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { getEntry } from "astro:content";

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative path to a 1200×630 image. */
  ogImage?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  ogImage = "/og.png",
  noindex = false,
  ogType = "website",
} = Astro.props;

const site = await getEntry("site", "main");
if (!site) throw new Error("site collection: entry 'main' missing");

const siteName = `${site.data.name.full} · ${site.data.jobTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0e0f12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Pre-paint flags (runs before first paint, no flash):
      - js-motion: JS on AND no reduced motion → [data-reveal] start hidden for GSAP.
      - save-data: Save-Data / 2G → videos render posters only.
      data-astro-rerun re-applies them after each View Transition swap.
    -->
    <script is:inline data-astro-rerun>
      (function () {
        var d = document.documentElement;
        var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var c = navigator.connection;
        var saveData = !!(c && (c.saveData || /2g/.test(c.effectiveType || "")));
        d.classList.toggle("js-motion", !reduced);
        d.classList.toggle("save-data", saveData);
      })();
    </script>

    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body class="bg-ink font-sans text-paper antialiased">
    <a
      href="#main"
      class="sr-only z-(--z-skip) rounded-sm bg-playhead px-4 py-2 font-medium text-ink focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      Skip to content
    </a>
    <slot name="chrome" />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <slot name="footer" />

    <script>
      import { initSmoothScroll } from "../lib/smooth-scroll";
      import { initReveal } from "../lib/reveal";
      initSmoothScroll();
      initReveal();
    </script>
  </body>
</html>
